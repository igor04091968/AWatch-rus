[Unit]
Description=AW-rus file-1C ingest cycle (Rust)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/activitywatch/clickhouse-1c
Environment=AW_1C_ROOT=/opt/activitywatch/clickhouse-1c
ExecStart=/usr/local/bin/aw-1c-ingest-rust --root /opt/activitywatch/clickhouse-1c
TimeoutStartSec=45min
User=root
Group=root
