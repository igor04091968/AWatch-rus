    }

    location = /js/aw-worktime-panel.js {
        proxy_set_header Authorization "";
        proxy_pass http://10.10.10.13:5600;
        proxy_redirect off;
        sub_filter_once off;
        sub_filter_types application/javascript text/javascript;
        sub_filter 'http://10.10.10.13:5610' '';
