    "/workforce/kpi/explain": {
      "get": {
        "tags": [
          "workforce"
        ],
        "summary": "Rule-based Workforce KPI explanation",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "department",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "owner",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "role",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/PortalRole"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Explainable Workforce KPI payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkforceKpiExplain"
                }
              }
            }
          },
          "400": {
            "description": "Query limits rejected"
          },
          "403": {
            "description": "Role denied"
          }
        }
      }
    },
    "/risk/narrative": {
      "get": {
        "tags": [
          "risk"
        ],
        "summary": "Rule-based executive risk narrative",
